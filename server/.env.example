# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hhfitclub
DB_USER=root
DB_PASS=

# ── App ──
JWT_SECRET=ganti-dengan-string-rahasia-panjang
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Backend URL (untuk URL gambar produk — WAJIB diisi di production/deploy) ──
# Development: biarkan kosong (otomatis pakai http://localhost:5000)
# Production : isi dengan URL server, misal https://api.domainanda.com
BACKEND_URL=

# ── Duitku Payment Gateway ──
# Daftar di https://www.duitku.com untuk mendapatkan kredensial
DUITKU_MERCHANT_CODE=DS12345
DUITKU_API_KEY=
DUITKU_ENV=sandbox
# sandbox   → https://sandbox.duitku.com/webapi/api
# production → https://passport.duitku.com/webapi/api
DUITKU_CALLBACK_URL=http://localhost:5000/api/duitku/callback
DUITKU_RETURN_URL=http://localhost:5173/order-success

# ── Midtrans (tidak lagi digunakan, bisa dikosongkan) ──
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
